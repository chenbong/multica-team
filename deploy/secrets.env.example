# Copy to deploy/secrets.env, or leave the file absent and deploy/start.sh will
# generate one on first start. Rotating JWT_SECRET invalidates every session.

export JWT_SECRET=replace-with-openssl-rand-base64-48
export MULTICA_PLUGIN_SECRET_KEY=replace-with-openssl-rand-base64-32

# Required for the database URL, cluster initialization and scheduled backups.
# Set a strong, deployment-specific value; never commit secrets.env.
export MULTICA_DATABASE_PASSWORD=replace-with-a-private-database-password
