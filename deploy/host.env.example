# Copy to deploy/host.env and adjust for the machine that runs this instance.
# Everything here overrides the defaults in deploy/env.sh. The real file is
# git-ignored: the repository only carries this template, so no deployment
# address, database name or branding lands in the public history.

# --- instance identity ---
export MULTICA_HOST_IP=127.0.0.1
export MULTICA_API_PORT=8006
export MULTICA_WEB_PORT=8004
export MULTICA_BRIDGE_PORT=8002
export MULTICA_DATABASE_NAME=multica
export MULTICA_PROFILE_NAME=multica-local
export MULTICA_NODE_BIN_DIR=/opt/node-v24.18.0/bin

# --- optional: who may sign in ---
# Comma-separated e-mail domains, e.g. MULTICA_ALLOWED_EMAIL_DOMAINS=example.com
# export MULTICA_ALLOWED_EMAIL_DOMAINS=

# --- optional: login-page branding ---
# Empty (or absent) keeps the upstream Multica copy. The verification-bot name
# and chat URL are what the login page links to when a code is required.
# export MULTICA_LOGIN_TITLE=
# export MULTICA_LOGIN_DESCRIPTION=
# export MULTICA_EMAIL_PLACEHOLDER=
# export MULTICA_VERIFICATION_BOT_NAME=
# export MULTICA_VERIFICATION_BOT_URL=

# --- optional: which installer the "add a computer" dialog advertises ---
# Point it at this repository's script so people install the overlay build:
# export MULTICA_CLI_INSTALL_URL=https://raw.githubusercontent.com/<owner>/<repo>/main/scripts/install.sh

# --- optional: source database for deploy/clone-db.sh ---
# export MULTICA_CLONE_SOURCE_DB=

# --- optional: IM open-platform endpoints for infoflow-bridge ---
# Empty keeps the SDK defaults; a network that only reaches an internal gateway
# points these at it.
# export INFOFLOW_BASE_URL=
# export INFOFLOW_WS_GATEWAY=
# export INFOFLOW_WS_CONNECT_DOMAIN=
